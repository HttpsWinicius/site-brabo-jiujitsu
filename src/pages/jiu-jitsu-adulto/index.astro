---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import FaqItem from "../../components/FaqItem.astro";
import Icon from "../../components/Icon.astro";
import { linkWhatsapp } from "../../lib/whatsapp.js";
import site from "../../data/site.json";
import faq from "../../data/faq.json";
import imagem from "../../assets/img/adulto.jpeg";

const cta = linkWhatsapp(site.nap.whatsappPrincipal, site.mensagemWhatsappPadrao);
const faqAdulto = faq.filter((f) => ["adulto", "primeira-aula"].includes(f.categoria));
---

<BaseLayout
  titulo="Jiu-Jitsu para Iniciantes em Juiz de Fora | Brabo"
  descricao="Jiu-Jitsu adulto em Juiz de Fora para iniciantes e avançados, em qualquer idade. Primeira aula experimental grátis."
>
  <PageHero imagem={imagem} alt="Equipe Brabo Jiu-Jitsu reunida após conquistar o título de campeã no 4º Campeonato Mineiro" titulo="Jiu-Jitsu Adulto" posicao="center 20%">
    <Fragment slot="intro">
      Do primeiro dia no tatame ao primeiro campeonato — turmas para iniciantes e avançados, em qualquer idade.
    </Fragment>
    <Fragment slot="acoes">
      <a class="botao" href={cta} target="_blank" rel="noopener">
        <Icon nome="whatsapp" tamanho={18} />
        Agende a aula experimental grátis
      </a>
    </Fragment>
  </PageHero>

  <section class="container secao">
    <h2>Nunca treinou? Sem problema.</h2>
    <p class="secao__intro">
      A maioria de quem começa no Jiu-Jitsu adulto nunca treinou nenhuma luta antes. As turmas são pensadas pra
      receber quem está pisando no tatame pela primeira vez — o ritmo se adapta a cada aluno, e a evolução acontece
      por progressão de faixa, não por comparação com quem já treina há anos.
    </p>
  </section>

  <section class="container secao">
    <h2>Como funciona a progressão</h2>
    <p class="secao__intro">
      Desde 2017, a Brabo Jiu-Jitsu usa uma metodologia própria dividida em módulos por faixa — do branco ao preto —
      pra dar um acompanhamento mais próximo do que cada aluno já entende de técnica. Veja o detalhe completo na
      página de <a href="/metodologia/">metodologia</a>.
    </p>
  </section>

  <section class="container secao">
    <h2>Perguntas frequentes</h2>
    {faqAdulto.map((f) => <FaqItem pergunta={f.pergunta}>{f.resposta}</FaqItem>)}
  </section>

  <section class="container secao secao--final">
    <p>Escolha a unidade mais perto e agende sua primeira aula, que é gratuita.</p>
    <div class="secao__cta">
      <a class="botao" href={cta} target="_blank" rel="noopener">
        <Icon nome="whatsapp" tamanho={18} />
        Chamar no WhatsApp
      </a>
      <a class="botao botao--contorno" href="/unidades/">Ver unidades</a>
    </div>
  </section>
</BaseLayout>

<style>
  .secao {
    padding-block: var(--espaco-5);
    max-width: 55rem;
  }

  .secao__intro {
    color: var(--cor-texto-muted);
  }

  .secao--final {
    padding-bottom: var(--espaco-7);
  }

  .secao__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espaco-2);
    margin-top: var(--espaco-3);
  }
</style>
