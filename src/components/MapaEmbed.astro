---
// Embed do Google Maps sem chave de API (endpoint público "output=embed").
interface Props {
  endereco: string;
  nome: string;
}

const { endereco, nome } = Astro.props;
const consulta = encodeURIComponent(`${nome}, ${endereco}`);
const src = `https://www.google.com/maps?q=${consulta}&output=embed`;
---

<div class="mapa-embed">
  <iframe
    src={src}
    title={`Mapa da localização: ${nome}`}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>

<style>
  .mapa-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--raio-borda);
    overflow: hidden;
    border: 1px solid var(--cor-borda);
  }

  .mapa-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
