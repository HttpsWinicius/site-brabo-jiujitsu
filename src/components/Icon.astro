---
// Ícones em SVG inline — sem Font Awesome, sem Bootstrap Icons, sem requisição externa.
interface Props {
  nome:
    | "whatsapp"
    | "instagram"
    | "facebook"
    | "youtube"
    | "telefone"
    | "local"
    | "menu"
    | "fechar"
    | "seta-baixo";
  tamanho?: number;
}

const { nome, tamanho = 24 } = Astro.props;
---

<svg
  class="icone"
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {
    nome === "whatsapp" && (
      <>
        <path
          d="M12 3a9 9 0 0 0-7.75 13.5L3 21l4.5-1.25A9 9 0 1 0 12 3z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <path
          d="M8.5 9.5c0 3 2 5.5 5 6.5l1.2-1.6c.2-.3.6-.4.9-.2.7.4 1.5.6 2.4.7.4 0 .7.4.6.8l-.3 1.5c-.1.5-.6.8-1 .8-5 0-9-4-9-9 0-.5.3-.9.8-1l1.5-.3c.4-.1.8.2.8.6.1.9.3 1.7.7 2.4.2.3.1.7-.2.9z"
          fill="currentColor"
        />
      </>
    )
  }
  {
    nome === "instagram" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.5" />
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5" />
        <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" />
      </>
    )
  }
  {
    nome === "facebook" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="4" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path
          d="M13.5 21v-7h2.2l.3-2.6h-2.5V9.7c0-.8.2-1.3 1.3-1.3h1.4V6.1c-.3 0-1.2-.1-2.1-.1-2.1 0-3.4 1.3-3.4 3.6v1.8H8.7v2.6H11V21z"
          fill="currentColor"
        />
      </>
    )
  }
  {
    nome === "youtube" && (
      <>
        <rect x="2" y="5" width="20" height="14" rx="4" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M10 9l6 3-6 3V9z" fill="currentColor" />
      </>
    )
  }
  {
    nome === "telefone" && (
      <path
        d="M6.6 3.5 9.3 9l-2 1.6a13 13 0 0 0 6.1 6.1l1.6-2 5.5 2.7a1 1 0 0 1 .5 1.2l-.9 2.7a1 1 0 0 1-1.1.7C10.3 21.3 2.7 13.7 2.2 5.1a1 1 0 0 1 .7-1.1l2.7-.9a1 1 0 0 1 1 .4z"
        fill="currentColor"
      />
    )
  }
  {
    nome === "local" && (
      <>
        <path
          d="M12 21s7-7.2 7-12a7 7 0 1 0-14 0c0 4.8 7 12 7 12z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <circle cx="12" cy="9" r="2.5" fill="currentColor" />
      </>
    )
  }
  {
    nome === "menu" && (
      <>
        <line x1="4" y1="7" x2="20" y2="7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="4" y1="12" x2="20" y2="12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="4" y1="17" x2="20" y2="17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </>
    )
  }
  {
    nome === "fechar" && (
      <>
        <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </>
    )
  }
  {
    nome === "seta-baixo" && (
      <polyline
        points="6 9 12 15 18 9"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    )
  }
</svg>
